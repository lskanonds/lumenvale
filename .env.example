# Copy to .env and fill in. Never commit .env.

# --- Required ---

# Local development uses the Postgres container in docker-compose.yml (host port 5434).
# In production, point this at a managed Postgres instance such as Neon.
DATABASE_URL=postgres://lumenvale:lumenvale_dev@127.0.0.1:5434/lumenvale

# Signs Payload auth tokens. Generate with: openssl rand -hex 24
PAYLOAD_SECRET=

# Absolute address of this deployment. Payload builds password-reset links from it, and
# the seed uses it for the canonical URL in Site settings.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Deployment switches ---

# Set to 1 on the live production deployment only. Everything else (preview deploys,
# local machines, copies of the database) stays closed to search engines.
ALLOW_INDEXING=

# Set to 1 on preview deploys: hides /admin and /api and adds a noindex header.
# Read at build time, so it has to be present for the build.
PREVIEW_MODE=

# --- Media storage ---

# Uploads go to Vercel Blob when deployed; Vercel injects this once a Blob store is
# connected to the project. Leave it empty locally so uploads stay on disk.
BLOB_READ_WRITE_TOKEN=

# --- Outgoing mail ---

# Password resets and enquiry notifications are sent through Resend. Leave the key empty
# locally: Payload then prints each email, including reset links, to the terminal.
# Send from a subdomain with its own SPF/DKIM records so the main domain is untouched.
RESEND_API_KEY=
EMAIL_FROM=no-reply@send.example.com
EMAIL_FROM_NAME=Lumenvale
